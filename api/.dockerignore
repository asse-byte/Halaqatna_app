# Never bake a developer's secrets, local database or installed packages into the image:
# the image installs its own vendor/ and takes its settings from docker/api's env_file.
.env
.env.*
!.env.example
vendor/
node_modules/
database/*.sqlite*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
storage/app/reports/
storage/app/mpdf/
bootstrap/cache/*.php
coverage/
.phpunit.result.cache
