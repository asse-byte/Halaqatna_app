# NOTE: quote any value containing '#'. Unquoted, dotenv reads '#' as the start of a comment,
# so DB_PASSWORD=Secret#2026 silently becomes "Secret" — which is how a strong-looking
# password ends up being five characters. Write DB_PASSWORD="Secret#2026".

APP_NAME=Halaqtna
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8 — the `db` service. Never published outside the internal bridge network.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=halaqtna
DB_USERNAME=halaqtna_api
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# The API runs migrations as the admin user, then serves requests as halaqtna_api,
# which has no UPDATE/DELETE grant on audit_log or xp_ledger (see scripts/db_grants.sql).

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Auth & RBAC Service. Use a long random string: `php artisan tinker --execute="echo bin2hex(random_bytes(32));"`
JWT_SECRET=
JWT_TTL_MINUTES=720

# ML Prediction Service (FR10) — internal HTTP only; this port is never published.
# Local development: http://127.0.0.1:8000. Under Docker Compose: http://ml:8000
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_SECONDS=3

# Set only behind a reverse proxy that overwrites X-Forwarded-For (see docker/nginx/default.conf).
# `*` trusts whoever connects, so it is safe only when the API cannot be reached directly.
TRUSTED_PROXIES=

# Seeded System Administrator (FR19). Both are required, the password at least 8 characters.
# It is used only when the account is first created; change it later from My Account.
SYS_ADMIN_EMAIL=admin@halaqtna.local
SYS_ADMIN_PASSWORD=
