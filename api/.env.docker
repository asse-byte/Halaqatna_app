# env_file for the `api` service in docker/docker-compose.yml.
# The placeholder secrets below match docker/mysql/init.sql. CHANGE ALL OF THEM
# before any deployment that is reachable by a real user.
#
# Quote any value containing '#'. Unquoted, dotenv reads '#' as the start of a comment,
# so DB_PASSWORD=Secret#2026 silently becomes "Secret". Write DB_PASSWORD="Secret#2026".
APP_NAME=Halaqtna
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=halaqtna
# The API serves requests as halaqtna_api, which by design holds no UPDATE/DELETE grant on
# audit_log or xp_ledger (rule 4). Never point this at halaqtna_admin: that user can rewrite
# the audit trail and the XP ledger, and the append-only guarantee would be void.
# Migrations run separately, as halaqtna_admin — see scripts/db_setup.sh.
DB_USERNAME=halaqtna_api
DB_PASSWORD=change-me-api
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

JWT_SECRET=change-me-to-a-64-character-random-string-before-deploying-halaqtna
JWT_TTL_MINUTES=720

ML_SERVICE_URL=http://ml:8000
ML_TIMEOUT_SECONDS=3

# nginx is the only way in (rule 6), so the address that connects is always the proxy.
# Trusting it is what lets the login throttle see each client's own IP (NFR3a) and share
# links come out as https:// (FR21). Never set this where the API is reachable directly.
TRUSTED_PROXIES=*

SYS_ADMIN_EMAIL=admin@halaqtna.local
SYS_ADMIN_PASSWORD=change-me-admin-password
