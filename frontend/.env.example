# Halaqtna — student dashboard + administration console.

# Where the Vite dev server forwards /api and /p (development only, read in Node).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Read by the browser. Empty = same origin, which is what both nginx and the dev proxy give.
# Set it only when the API is served from a different origin than the SPA.
VITE_API_URL=

# Optional, development only: adds a one-click sign-in button for the seeded System
# Administrator. Mirror SYS_ADMIN_EMAIL / SYS_ADMIN_PASSWORD from api/.env. The demo buttons
# are compiled out of a production build, but leave these empty unless you are demoing locally.
VITE_DEMO_SYS_ADMIN_EMAIL=
VITE_DEMO_SYS_ADMIN_PASSWORD=
